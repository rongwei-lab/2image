# 二开应用展示名，会显示在顶部标题和关于页。
VITE_APP_NAME="GPT Image Playground"

# 二开作者或团队名称，会显示在帮助页和关于页。
VITE_APP_AUTHOR_NAME="@YourName"

# 二开后的主仓库地址。没有自建仓库时可以先留空或沿用默认值。
VITE_APP_REPOSITORY_URL="https://github.com/your-name/your-repo"

# 反馈入口地址，默认会基于 VITE_APP_REPOSITORY_URL 拼接 /issues。
VITE_APP_ISSUES_URL="https://github.com/your-name/your-repo/issues"

# 新版本提示跳转地址，默认会基于 VITE_APP_REPOSITORY_URL 拼接 /releases/latest。
VITE_APP_RELEASES_URL="https://github.com/your-name/your-repo/releases/latest"

# 新版本检查接口。如果你的二开仓库不使用 GitHub Releases，可以替换为兼容 tag_name/html_url 的接口。
VITE_APP_RELEASE_API_URL="https://api.github.com/repos/your-name/your-repo/releases/latest"

# Release API 的 Accept 请求头，使用 GitHub Releases 时保持默认即可。
VITE_APP_RELEASE_API_ACCEPT="application/vnd.github.v3+json"
